# Run scripts/setup-admin.mjs to generate a unique token and this file's real values.
# Never use the example as a production password or fill in a fixed setup token.
ADMIN_SETUP_TOKEN_HASH=

# Keep empty for IP access and the documented localhost SSH tunnel.
# Set to https://your-domain.example after configuring HTTPS.
APP_ORIGIN=

# Docker named volume: SQLite database and uploaded images.
JOURNAL_DATA_VOLUME=juicegao_data

# Public HTTP front page. Set HTTP_BIND=127.0.0.1 to restrict the HTTP entry to server-local access.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
