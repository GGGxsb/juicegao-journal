# Run scripts/setup-admin.mjs to generate a unique token and this file's real values.
# Never use the example as a production password or fill in a fixed setup token.
ADMIN_SETUP_TOKEN_HASH=

# Keep empty for IP access and the documented localhost SSH tunnel.
# Set to https://your-domain.example after configuring HTTPS.
APP_ORIGIN=

# Docker named volume: SQLite database and uploaded images.
JOURNAL_DATA_VOLUME=juicegao_data

# Public HTTP front page. Set HTTP_BIND=127.0.0.1 to restrict the HTTP entry to server-local access.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# HTTPS deployment: set your certificate's domain, without a scheme or path.
# Used by deploy/compose.nginx-https.yaml and deploy/compose.https.yaml.
SITE_DOMAIN=

# Optional visitor login for comments. Values stay server-side; never use NEXT_PUBLIC_*.
# QQ callback: https://your-domain.example/api/comment-auth/qq/callback
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
# GitHub callback: https://your-domain.example/api/comment-auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
